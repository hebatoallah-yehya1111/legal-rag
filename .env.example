# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3

# LLM provider
LLM_MODEL_NAME=placeholder-llm
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
RAGAS_PROVIDER=groq
RAGAS_GROQ_MODEL=qwen/qwen3.8-27b
RAGAS_RPM=8

# Vector database
VECTOR_DB_DIR=data/processed/vector_store
VECTOR_COLLECTION_NAME=egyptian_civil_code

# Data
RAW_PDF_PATH=data/raw/egyptian_civil_code.pdf
PROCESSED_JSON_PATH=data/processed/articles.json
CHUNKS_JSON_PATH=data/processed/chunks.json

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=legal-rag-chunking

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Evaluation
RAGAS_FAITHFULNESS_THRESHOLD=0.75

# Alerts (Slack or Discord incoming webhook URL, optional)
ALERT_WEBHOOK_URL=
